{
  "name": "@agentfluency/db",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "build": "tsc -b",
    "check-types": "tsc -b",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate:deploy": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "drizzle-kit migrate",
    "db:start": "docker compose -f ../docker/docker-compose.yml up -d postgres",
    "db:watch": "docker compose -f ../docker/docker-compose.yml up postgres",
    "db:stop": "docker compose -f ../docker/docker-compose.yml stop postgres",
    "db:down": "docker compose -f ../docker/docker-compose.yml down postgres"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "pg": "^8.23.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@agentfluency/config": "workspace:*",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "1.0.0-rc.5",
    "typescript": "catalog:",
    "varlock": "catalog:"
  }
}
