{
  "name": "agentfluency",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.6.7",
      "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
      "typescript": "^6.0.3",
      "varlock": "1.25.0",
      "next-themes": "^0.4.6",
      "react": "^19.3.1",
      "react-dom": "^19.3.1",
      "sonner": "^2.0.8",
      "tailwindcss": "^4.3.5",
      "@orpc/server": "^1.16.2",
      "@orpc/client": "^1.16.2",
      "@orpc/openapi": "^1.16.2",
      "@orpc/zod": "^1.16.2",
      "better-auth": "1.7.22",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "drizzle-orm": "1.0.0-rc.5"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "vp run -r dev",
    "build": "vp run -r build",
    "check-types": "vp run -r check-types",
    "test": "vp test",
    "check": "vp check && vp run -r check-types",
    "fix": "vp check --fix",
    "lint": "vp lint",
    "format": "vp fmt",
    "staged": "vp staged",
    "hooks:setup": "vp hooks enable",
    "dev:web": "vp run --filter web dev",
    "db:push": "vp run --filter @agentfluency/db db:push",
    "db:studio": "vp run --filter @agentfluency/db db:studio",
    "db:generate": "vp run --filter @agentfluency/db db:generate",
    "db:migrate": "vp run --filter @agentfluency/db db:migrate",
    "db:start": "vp run --filter @agentfluency/db db:start",
    "db:watch": "vp run --filter @agentfluency/db db:watch",
    "db:stop": "vp run --filter @agentfluency/db db:stop",
    "db:down": "vp run --filter @agentfluency/db db:down",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/",
    "auth:generate": "cd apps/web && bun run auth:generate"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@agentfluency/config": "workspace:*",
    "@types/node": "^26.6.6",
    "rolldown": "1.3.2",
    "typescript": "catalog:",
    "ultracite": "8.3.0",
    "varlock": "catalog:",
    "vite": "catalog:",
    "vite-plus": "1.6.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0"
  },
  "packageManager": "bun@1.4.4"
}
